# Public IP of this server, e.g. 203.0.113.10. Caddy serves HTTPS on it with a certificate from its own CA.
SERVER_IP=
LITELLM_IMAGE=

# Generated by start.sh on first run. Back up this file: LITELLM_SALT_KEY encrypts stored provider keys and must never change.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_USER=qosllm
POSTGRES_PASSWORD=
POSTGRES_DB=qosllm
