# Domain that points at this server, e.g. qos.example.com. Caddy obtains an HTTPS certificate for it automatically.
# Use :80 only for a trial without a domain: everything, passwords included, then travels unencrypted.
SITE_ADDRESS=

# Generated by start.sh on first run. Back up this file: LITELLM_SALT_KEY encrypts stored provider keys and must never change.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_USER=qosllm
POSTGRES_PASSWORD=
POSTGRES_DB=qosllm
